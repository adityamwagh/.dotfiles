[Appearance]
ColorScheme=github-dark-default
Font=Iosevka Extended,11,-1,5,50,0,0,0,0,0

[Cursor Options]
CursorShape=1

[General]
Directory=~
LocalTabTitleFormat=%n
Name=Dark
Parent=FALLBACK/
RemoteTabTitleFormat=%u
StartInCurrentSessionDir=true
TerminalMargin=12

[Scrolling]
HistoryMode=2
ScrollBarPosition=2

[Terminal Features]
BellMode=3
