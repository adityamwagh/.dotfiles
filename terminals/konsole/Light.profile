[Appearance]
ColorScheme=GitHub Light Default
Font=Twilio Sans Mono Retina,10,-1,5,51,0,0,0,0,0,Regular

[Cursor Options]
CursorShape=1

[General]
LocalTabTitleFormat=%n
Name=Light
Parent=FALLBACK/
RemoteTabTitleFormat=%u
StartInCurrentSessionDir=false
TerminalMargin=12

[Scrolling]
HistoryMode=2
ScrollBarPosition=2

[Terminal Features]
BellMode=3
