# Crush config (API key comes from $LITHOSAI_API_KEY, e.g. via ~/.env)

# LSPs
lsp add rust_analyzer \
  --command rust-analyzer \
  --filetypes rust \
  --root-markers Cargo.toml \
  --root-markers rust-toolchain.toml \
  --root-markers .git

lsp add pyrefly \
  --command pyrefly \
  --args lsp \
  --filetypes python \
  --root-markers pyrefly.toml \
  --root-markers pyproject.toml \
  --root-markers setup.py \
  --root-markers setup.cfg \
  --root-markers requirements.txt \
  --root-markers Pipfile \
  --root-markers .git

provider add lithosai \
  --name "LithosAI" \
  --type openai-compat \
  --base-url "https://api.lithosai.cloud/v1" \
  --api-key "$LITHOSAI_API_KEY"

# DeepSeek
