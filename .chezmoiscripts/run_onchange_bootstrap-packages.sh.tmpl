#!/usr/bin/env bash
# {{ include "dot_Brewfile" | sha256sum }}
{{- if (env "DOTFILES_SERVER") }}
{{- if eq .chezmoi.os "linux" }}
set -euo pipefail
pkgs=({{ range .packages.linux.server }}{{ . | quote }} {{ end }})
if command -v apt-get >/dev/null 2>&1; then
  sudo apt-get update -qq
  sudo apt-get install -y "${pkgs[@]}"
elif command -v dnf >/dev/null 2>&1; then
  sudo dnf install -y "${pkgs[@]}"
fi
{{- end }}
{{- else if eq .chezmoi.os "darwin" }}
set -euo pipefail
command -v brew >/dev/null 2>&1 && brew bundle --file "$HOME/.Brewfile"
{{- else if eq .chezmoi.os "linux" }}
set -euo pipefail
pkgs=({{ range .packages.linux.desktop }}{{ . | quote }} {{ end }})
if command -v apt-get >/dev/null 2>&1; then
  sudo apt-get update -qq
  sudo apt-get install -y "${pkgs[@]}"
elif command -v dnf >/dev/null 2>&1; then
  sudo dnf install -y "${pkgs[@]}"
fi
# watchman ships no native Linux package; install it from Homebrew when present.
if ! command -v watchman >/dev/null 2>&1 && command -v brew >/dev/null 2>&1; then
  brew install watchman
fi
{{- end }}