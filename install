#!/usr/bin/env bash
set -euo pipefail

DOTFILES_DIR="$(cd "$(dirname "$0")" && pwd)"
DOTBOT_DIR="$DOTFILES_DIR/dotbot"

# Trust all Brewfile taps; fresh machines have no per-tap trust recorded.
export HOMEBREW_NO_REQUIRE_TAP_TRUST=1

# --server installs a headless profile: no Homebrew, no GUI apps, no fonts,
# no LLM runtimes. The flag is consumed here; dotbot never sees it.
args=()
for arg in "$@"; do
  case "$arg" in
    --server) export DOTFILES_SERVER=1 ;;
    *) args+=("$arg") ;;
  esac
done

if [ ! -x "$DOTBOT_DIR/bin/dotbot" ] ||
  [ ! -f "$DOTBOT_DIR/lib/pyyaml/lib/yaml/__init__.py" ] ||
  [ ! -f "$DOTFILES_DIR/dotbot-brew/brew.py" ] ||
  [ ! -f "$DOTFILES_DIR/dotbot-unipkg/unipkg.py" ]; then
  git -C "$DOTFILES_DIR" submodule update --init --recursive
fi

# Strip tasks whose `server:` marker does not match the current profile.
filtered_config="$(mktemp)"
trap 'rm -f "$filtered_config"' EXIT
PYTHONPATH="$DOTBOT_DIR/lib/pyyaml/lib${PYTHONPATH:+:$PYTHONPATH}" \
  python3 "$DOTFILES_DIR/scripts/filter-install-config.py" \
  "$DOTFILES_DIR/install.conf.yaml" "$filtered_config"

"$DOTBOT_DIR/bin/dotbot" -d "$DOTFILES_DIR" -c "$filtered_config" \
  --plugin-dir "$DOTFILES_DIR/dotbot-brew" \
  --plugin-dir "$DOTFILES_DIR/dotbot-unipkg" ${args[@]+"${args[@]}"}
