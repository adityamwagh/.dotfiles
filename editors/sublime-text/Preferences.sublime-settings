// Sublime Text settings
//
// Mirrors editors/zed/settings.json and editors/nvim/lua/core/options.lua so
// all three editors indent, wrap and guide identically.
{
    "color_scheme": "auto", // Follow the system appearance, like Zed's theme.mode.
    "dark_color_scheme": "Flexoki Dark.sublime-color-scheme",
    "default_line_ending": "unix", // Match .stylua.toml line_endings.
    "ensure_newline_at_eof_on_save": true,
    "font_face": "Source Code Pro", // Match Zed buffer_font_family.
    "font_size": 14, // Match Zed buffer_font_size.
    "highlight_line": true, // Match nvim cursorline.
    "light_color_scheme": "Flexoki Light.sublime-color-scheme",
    "line_numbers": true, // Match nvim number.
    "rulers": [88, 120], // Match Zed wrap_guides.
    "scroll_past_end": false, // Match Zed scroll_beyond_last_line="off".
    "tab_size": 4, // Match Zed tab_size and nvim shiftwidth.
    "translate_tabs_to_spaces": true, // Match Zed hard_tabs=false and nvim expandtab.
    "trim_trailing_white_space_on_save": "all", // Match the repo's trailing-whitespace hook.
    "word_wrap": true, // Match Zed soft_wrap="prefer_line".
    "wrap_width": 88, // Match Zed preferred_line_length.
}
