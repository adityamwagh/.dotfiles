{
    "name": "GitHub Light Colorblind",
    "author": "GitHub (primer), generated from github-vscode-theme",
    "globals": {
        "background": "#ffffff",
        "foreground": "#24292f",
        "caret": "#0969da",
        "block_caret": "#0969da",
        "line_highlight": "#f4f6f8",
        "selection": "#eff1f3",
        "selection_foreground": "#24292f",
        "inactive_selection": "#f4f6f8",
        "find_highlight": "#f4f6f8",
        "find_highlight_foreground": "#0969da",
        "gutter": "#ffffff",
        "gutter_foreground": "#57606a",
        "gutter_foreground_highlight": "#24292f",
        "accent": "#0969da",
        "misspelling": "#b35900",
        "invisibles": "#57606a",
        "highlight": "#57606a",
        "shadow": "#ffffff",
        "shadow_width": "4",
        "line_diff_added": "#80ccff80",
        "line_diff_modified": "#633c01"
    },
    "rules": [
        {
            "scope": "comment, punctuation.definition.comment, string.comment",
            "foreground": "#6e7781"
        },
        {
            "scope": "constant.other.placeholder, constant.character",
            "foreground": "#b35900"
        },
        {
            "scope": "constant, entity.name.constant, variable.other.constant, variable.other.enummember, variable.language, entity",
            "foreground": "#0550ae"
        },
        {
            "scope": "entity.name, meta.export.default, meta.definition.variable",
            "foreground": "#8a4600"
        },
        {
            "scope": "variable.parameter.function, meta.jsx.children, meta.block, meta.tag.attributes, entity.name.constant, meta.object.member, meta.embedded.expression",
            "foreground": "#24292f"
        },
        {
            "scope": "entity.name.function",
            "foreground": "#8250df"
        },
        {
            "scope": "entity.name.tag, support.class.component",
            "foreground": "#0550ae"
        },
        {
            "scope": "keyword",
            "foreground": "#b35900"
        },
        {
            "scope": "storage, storage.type",
            "foreground": "#b35900"
        },
        {
            "scope": "storage.modifier.package, storage.modifier.import, storage.type.java",
            "foreground": "#24292f"
        },
        {
            "scope": "string, string punctuation.section.embedded source",
            "foreground": "#0a3069"
        },
        {
            "scope": "support",
            "foreground": "#0550ae"
        },
        {
            "scope": "meta.property-name",
            "foreground": "#0550ae"
        },
        {
            "scope": "variable",
            "foreground": "#8a4600"
        },
        {
            "scope": "variable.other",
            "foreground": "#24292f"
        },
        {
            "scope": "invalid.broken",
            "foreground": "#6f3800",
            "font_style": "italic"
        },
        {
            "scope": "invalid.deprecated",
            "foreground": "#6f3800",
            "font_style": "italic"
        },
        {
            "scope": "invalid.illegal",
            "foreground": "#6f3800",
            "font_style": "italic"
        },
        {
            "scope": "invalid.unimplemented",
            "foreground": "#6f3800",
            "font_style": "italic"
        },
        {
            "scope": "carriage-return",
            "foreground": "#f6f8fa",
            "background": "#b35900",
            "font_style": "italic underline"
        },
        {
            "scope": "message.error",
            "foreground": "#6f3800"
        },
        {
            "scope": "string variable",
            "foreground": "#0550ae"
        },
        {
            "scope": "source.regexp, string.regexp",
            "foreground": "#0a3069"
        },
        {
            "scope": "string.regexp.character-class, string.regexp constant.character.escape, string.regexp source.ruby.embedded, string.regexp string.regexp.arbitrary-repitition",
            "foreground": "#0a3069"
        },
        {
            "scope": "string.regexp constant.character.escape",
            "foreground": "#0550ae",
            "font_style": "bold"
        },
        {
            "scope": "support.constant",
            "foreground": "#0550ae"
        },
        {
            "scope": "support.variable",
            "foreground": "#0550ae"
        },
        {
            "scope": "support.type.property-name.json",
            "foreground": "#0550ae"
        },
        {
            "scope": "meta.module-reference",
            "foreground": "#0550ae"
        },
        {
            "scope": "punctuation.definition.list.begin.markdown",
            "foreground": "#8a4600"
        },
        {
            "scope": "markup.heading, markup.heading entity.name",
            "foreground": "#0550ae",
            "font_style": "bold"
        },
        {
            "scope": "markup.quote",
            "foreground": "#0550ae"
        },
        {
            "scope": "markup.italic",
            "foreground": "#24292f",
            "font_style": "italic"
        },
        {
            "scope": "markup.bold",
            "foreground": "#24292f",
            "font_style": "bold"
        },
        {
            "scope": "markup.underline",
            "font_style": "underline"
        },
        {
            "scope": "markup.strikethrough",
            "font_style": "strikethrough"
        },
        {
            "scope": "markup.inline.raw",
            "foreground": "#0550ae"
        },
        {
            "scope": "markup.deleted, meta.diff.header.from-file, punctuation.definition.deleted",
            "foreground": "#6f3800",
            "background": "#fff5e8"
        },
        {
            "scope": "punctuation.section.embedded",
            "foreground": "#b35900"
        },
        {
            "scope": "markup.inserted, meta.diff.header.to-file, punctuation.definition.inserted",
            "foreground": "#0550ae",
            "background": "#ddf4ff"
        },
        {
            "scope": "markup.changed, punctuation.definition.changed",
            "foreground": "#8a4600",
            "background": "#ffddb0"
        },
        {
            "scope": "markup.ignored, markup.untracked",
            "foreground": "#eaeef2",
            "background": "#0550ae"
        },
        {
            "scope": "meta.diff.range",
            "foreground": "#8250df",
            "font_style": "bold"
        },
        {
            "scope": "meta.diff.header",
            "foreground": "#0550ae"
        },
        {
            "scope": "meta.separator",
            "foreground": "#0550ae",
            "font_style": "bold"
        },
        {
            "scope": "meta.output",
            "foreground": "#0550ae"
        },
        {
            "scope": "brackethighlighter.tag, brackethighlighter.curly, brackethighlighter.round, brackethighlighter.square, brackethighlighter.angle, brackethighlighter.quote",
            "foreground": "#57606a"
        },
        {
            "scope": "brackethighlighter.unmatched",
            "foreground": "#6f3800"
        },
        {
            "scope": "constant.other.reference.link, string.other.link",
            "foreground": "#0a3069"
        }
    ]
}
