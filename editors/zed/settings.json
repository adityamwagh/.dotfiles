// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
    "reveal_if_open": true,
    "agent": {
        "flexible": false,
        "threads_sidebar": {
            "position": "right",
            "default_width": 420
        },
        "sandbox_permissions": {
            "allow_unsandboxed": true
        },
        "dock": "left",
        "favorite_models": [],
        "model_parameters": [],
        "default_width": 420
    },
    "cli_default_open_behavior": "existing_window",
    "active_pane_modifiers": {
        "border_size": 4,
        "inactive_opacity": 1
    },
    "bottom_dock_layout": "contained",
    "agent_servers": {
        "claude-acp": {
            "type": "registry"
        },
        "github-copilot": {
            "type": "registry"
        }
    },
    "auto_install_extensions": {
        "catppuccin-icons": true,
        "dockerfile": true,
        "git-firefly": true,
        "github-actions": true,
        "html": true,
        "just": true,
        "liquid": true,
        "lua": true,
        "make": true,
        "material-icon-theme": true,
        "neocmake": true,
        "nix": true,
        "python-requirements": true,
        "rainbow-csv": true,
        "scss": true,
        "toml": true
    },
    "auto_update_extensions": {
        "catppuccin-icons": true,
        "dockerfile": true,
        "git-firefly": true,
        "github-actions": true,
        "html": true,
        "just": true,
        "liquid": true,
        "lua": true,
        "make": true,
        "material-icon-theme": true,
        "neocmake": true,
        "nix": true,
        "python-requirements": true,
        "rainbow-csv": true,
        "scss": true,
        "toml": true
    },
    "auto_indent_on_paste": true,
    "auto_signature_help": true,
    "autosave": {
        "after_delay": {
            "milliseconds": 0
        }
    },
    "base_keymap": "VSCode",
    "buffer_font_fallbacks": [
        "Iosevka Extended"
    ],
    "buffer_font_family": "Iosevka Extended",
    "buffer_font_size": 12,
    "buffer_font_weight": 400,
    "buffer_line_height": "comfortable",
    "centered_layout": {
        "left_padding": 0.2,
        "right_padding": 0.2
    },
    "close_on_file_delete": true,
    "collaboration_panel": {
        "button": false,
        "dock": "right",
        "default_width": 420
    },
    "debugger": {
        "dock": "left"
    },
    "diagnostics": {
        "inline": {
            "min_column": 0,
            "padding": 4
        }
    },
    "drop_target_size": 0.2,
    "edit_predictions": {
        "allow_data_collection": "no",
        "mode": "eager",
        "provider": "zed"
    },
    "extend_comment_on_newline": true,
    "file_scan_exclusions": [
        "**/node_modules",
        "**/.venv",
        "**/venv",
        "**/__pycache__",
        "**/target",
        "**/dist",
        "**/build",
        "**/*.egg-info",
        "..."
    ],
    "file_finder": {
        "modal_max_width": "small"
    },
    "git": {
        "gutter_debounce": 100,
        "inline_blame": {
            "padding": 7
        }
    },
    "git_panel": {
        "dock": "left",
        "tree_view": true,
        "default_width": 420
    },
    "gutter": {
        "min_line_number_digits": 4
    },
    "global_lsp_settings": {
        "notifications": {
            "dismiss_timeout_ms": 5000
        }
    },
    "hard_tabs": false,
    "hidden_files": [
        "**/*.pyc",
        "**/*.pyo",
        "..."
    ],
    "horizontal_scroll_margin": 5,
    "icon_theme": {
        "dark": "Material Icon Theme",
        "light": "Catppuccin Latte",
        "mode": "system"
    },
    "hover_popover_delay": 500,
    "indent_guides": {
        "active_line_width": 1,
        "line_width": 1
    },
    "inlay_hints": {
        "enabled": true
    },
    "language_models": {
        "openai_compatible": {
            "lithosai": {
                "api_url": "https://api.lithosai.cloud/v1",
                "available_models": [
                    {
                        "name": "deepseek-ai/DeepSeek-V4.1-Flash",
                        "display_name": "DeepSeek V4.1 Flash",
                        "max_tokens": 1048576,
                        "max_output_tokens": 32768
                    },
                    {
                        "name": "deepseek-ai/DeepSeek-V4.1-Flash-fast",
                        "display_name": "DeepSeek V4.1 Flash fast",
                        "max_tokens": 1048576,
                        "max_output_tokens": 32768
                    },
                    {
                        "name": "deepseek-ai/DeepSeek-V4.1-Flash-ultra",
                        "display_name": "DeepSeek V4.1 Flash ultra",
                        "max_tokens": 1048576,
                        "max_output_tokens": 32768
                    },
                    {
                        "name": "deepseek-ai/DeepSeek-V4.1-Flash-ultra-chat",
                        "display_name": "DeepSeek V4.1 Flash ultra chat",
                        "max_tokens": 1048576,
                        "max_output_tokens": 32768
                    },
                    {
                        "name": "zai-org/GLM-5.3",
                        "display_name": "GLM 5.3",
                        "max_tokens": 1048576,
                        "max_output_tokens": 32768
                    },
                    {
                        "name": "zai-org/GLM-5.3-ultra-chat",
                        "display_name": "GLM 5.3 ultra chat",
                        "max_tokens": 1048576,
                        "max_output_tokens": 32768
                    },
                    {
                        "name": "zai-org/GLM-5.3-Flash",
                        "display_name": "GLM 5.3 Flash",
                        "max_tokens": 1048576,
                        "max_output_tokens": 32768
                    },
                    {
                        "name": "zai-org/GLM-5.3-Flash-ultra",
                        "display_name": "GLM 5.3 Flash ultra",
                        "max_tokens": 1048576,
                        "max_output_tokens": 32768
                    },
                    {
                        "name": "zai-org/GLM-5.3-Flash-ultra-chat",
                        "display_name": "GLM 5.3 Flash ultra chat",
                        "max_tokens": 1048576,
                        "max_output_tokens": 32768
                    },
                    {
                        "name": "moonshotai/Kimi-K3",
                        "display_name": "Kimi K3",
                        "max_tokens": 1048576,
                        "max_output_tokens": 32768
                    },
                    {
                        "name": "moonshotai/Kimi-K3-fast",
                        "display_name": "Kimi K3 fast",
                        "max_tokens": 1048576,
                        "max_output_tokens": 32768
                    },
                    {
                        "name": "moonshotai/Kimi-K3-ultra",
                        "display_name": "Kimi K3 ultra",
                        "max_tokens": 1048576,
                        "max_output_tokens": 32768
                    },
                    {
                        "name": "moonshotai/Kimi-K3-ultra-chat",
                        "display_name": "Kimi K3 ultra chat",
                        "max_tokens": 1048576,
                        "max_output_tokens": 32768
                    }
                ]
            }
        }
    },
    "languages": {
        "Python": {
            "language_servers": [
                "ty",
                "ruff"
            ],
            "code_actions_on_format": {
                "source.fixAll.ruff": true,
                "source.organizeImports.ruff": true
            },
            "format_on_save": "on",
            "formatter": {
                "external": {
                    "command": "black",
                    "arguments": [
                        "--line-length",
                        "88",
                        "--preview",
                        "--stdin-filename",
                        "{buffer_path}",
                        "-"
                    ]
                }
            }
        },
        "TypeScript": {
            "format_on_save": "on",
            "formatter": {
                "external": {
                    "command": "prettier",
                    "arguments": ["--stdin-filepath", "{buffer_path}"]
                }
            }
        },
        "TSX": {
            "format_on_save": "on",
            "formatter": {
                "external": {
                    "command": "prettier",
                    "arguments": ["--stdin-filepath", "{buffer_path}"]
                }
            }
        },
        "JavaScript": {
            "format_on_save": "on",
            "formatter": {
                "external": {
                    "command": "prettier",
                    "arguments": ["--stdin-filepath", "{buffer_path}"]
                }
            }
        },
        "JSX": {
            "format_on_save": "on",
            "formatter": {
                "external": {
                    "command": "prettier",
                    "arguments": ["--stdin-filepath", "{buffer_path}"]
                }
            }
        },
        "CSS": {
            "format_on_save": "on",
            "formatter": {
                "external": {
                    "command": "prettier",
                    "arguments": ["--stdin-filepath", "{buffer_path}"]
                }
            }
        },
        "SCSS": {
            "format_on_save": "on",
            "formatter": {
                "external": {
                    "command": "prettier",
                    "arguments": ["--stdin-filepath", "{buffer_path}"]
                }
            }
        }
    },
    "line_indicator_format": "long",
    "lsp": {
        "ty": {
            "binary": {
                "path": "ty",
                "arguments": ["server"]
            }
        },
        "ruff": {
            "binary": {
                "path": "ruff",
                "arguments": ["server"]
            }
        }
    },
    "minimap": {
        "max_width_columns": 80
    },
    "minimum_split_diff_width": 100,
    "outline_panel": {
        "dock": "left",
        "indent_size": 24,
        "default_width": 420
    },
    "preferred_line_length": 88,
    "project_panel": {
        "dock": "left",
        "entry_spacing": "standard",
        "hide_hidden": true,
        "indent_size": 8,
        "default_width": 420
    },
    "redact_private_values": false,
    "resize_all_panels_in_dock": [
        "left"
    ],
    "restore_on_startup": "last_workspace",
    "scroll_beyond_last_line": "off",
    "preview_tabs": {
        "enabled": true
    },
    "semantic_tokens": "combined",
    "session": {
        "trust_all_worktrees": true
    },
    "show_wrap_guides": true,
    "soft_wrap": "prefer_line",
    "status_bar": {
        "active_language_button": true,
        "cursor_position_button": true,
        "line_endings_button": true
    },
    "tab_size": 4,
    "tabs": {
        "activate_on_close": "history",
        "close_position": "right",
        "file_icons": true,
        "git_status": true,
        "show_close_button": "always",
        "show_diagnostics": "all"
    },
    "terminal": {
        "blinking": "on",
        "cursor_shape": "bar",
        "flexible": true,
        "line_height": "standard"
    },
    "theme": {
        "dark": "Flexoki Dark",
        "light": "Ayu Light",
        "mode": "system"
    },
    "title_bar": {
        "show_branch_name": true,
        "show_branch_status_icon": true,
        "show_menus": true,
        "show_onboarding_banner": true,
        "show_project_items": true,
        "show_sign_in": true,
        "show_user_picture": true
    },
    "toolbar": {
        "agent_review": true,
        "breadcrumbs": true,
        "code_actions": true,
        "quick_actions": true,
        "selections_menu": true
    },
    "ui_font_family": "TeX Gyre Heros",
    "use_auto_surround": true,
    "use_autoclose": true,
    "use_system_window_tabs": true,
    "vertical_scroll_margin": 3,
    "vim_mode": false,
    "wrap_guides": [
        88,
        120
    ],
    "zoomed_padding": true
}
