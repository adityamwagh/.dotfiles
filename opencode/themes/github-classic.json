    "darkBg": "#24292e",
    "darkBgAlt": "#1f2428",
    "darkBgPanel": "#2f363d",
    "darkFg": "#e1e4e8",
    "darkFgMuted": "#6a737d",
    "darkBorder": "#444d56",
    "darkBorderSubtle": "#2f363d",
    "darkBlue": "#79b8ff",
    "darkGreen": "#85e89d",
    "darkRed": "#f97583",
    "darkOrange": "#ffab70",
    "darkPurple": "#b392f0",
    "darkPink": "#f97583",
    "darkYellow": "#ffea7f",
    "darkCyan": "#39c5cf",
    "darkString": "#9ecbff",
    "lightBg": "#ffffff",
